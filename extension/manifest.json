{
  "manifest_version": 3,
  "name": "Gitbrag for GitHub",
  "short_name": "Gitbrag",
  "description": "Show Gitbrag summaries on public GitHub profiles and repositories.",
  "version": "0.9.11",
  "homepage_url": "https://jpluker.github.io/Gitbrag/",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github-contributions-api.jogruber.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gitbrag settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "core.js",
        "stats.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
